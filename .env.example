# ============================================
# FFmpeg Converter App - Environment Variables
# ============================================
#
# This file contains example configuration values.
# Copy this file to .env and replace with your actual values.
#
# IMPORTANT: Never commit .env to version control!
# The .env file contains sensitive API keys.
#
# ============================================

# ---------------------------------------------
# Analytics Configuration
# ---------------------------------------------

# Cloudflare Worker Analytics Endpoint
# This is the URL of your deployed Cloudflare Worker
# Example: https://your-worker-name.your-subdomain.workers.dev
ANALYTICS_WORKER_URL=https://ffmpeg-analytics-worker.thuanc177.workers.dev

# API Key for authenticating analytics requests
# SECURITY: Generate a strong random key for production!
# 
# Generate using one of these methods:
#   - OpenSSL: openssl rand -base64 32
#   - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   - Online: https://www.uuidgenerator.net/api/guid (use GUID as key)
#
# NEVER use 'your-api-key' or other default values in production!
ANALYTICS_API_KEY=your-api-key

# ---------------------------------------------
# Build Configuration Notes
# ---------------------------------------------
#
# For local development:
#   - Create .env file with your credentials
#   - Run: flutter run
#
# For production builds (CI/CD):
#   - Pass secrets via --dart-define flags:
#     flutter build windows \
#       --dart-define=ANALYTICS_WORKER_URL=https://your-url.workers.dev \
#       --dart-define=ANALYTICS_API_KEY=your_secure_key_here
#
# For testing without analytics:
#   - Leave ANALYTICS_API_KEY as 'your-api-key'
#   - App will log warnings but continue to work
#
# ============================================

